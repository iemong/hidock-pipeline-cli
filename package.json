{
  "name": "hidock-pipeline",
  "version": "0.1.0",
  "type": "module",
  "description": "Pull meeting recordings off a HiDock P1, transcribe/summarize them with Gemini, and land the notes in Obsidian.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iemong/hidock-pipeline-cli.git"
  },
  "bin": {
    "hidock": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run check && npm run deps:cycle && npm run coverage",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "deps:cycle": "madge --circular --extensions ts src",
    "start": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run verify && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "madge": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "usb": "^3.0.1"
  }
}
