{
  "name": "hidock-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HiDock P1 の会議録音を吸い出し、Gemini で文字起こし・要約して Obsidian に着地させるパイプライン",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run check && npm run deps:cycle && npm run coverage",
    "check": "biome check --error-on-warnings .",
    "check:fix": "biome check --write --error-on-warnings .",
    "deps:cycle": "madge --circular --extensions ts src",
    "start": "node src/cli.ts",
    "install-agent": "bash scripts/install-agent.sh",
    "build-app": "bash scripts/build-app.sh",
    "install-raycast": "bash scripts/install-raycast.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "madge": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "usb": "^3.0.1"
  }
}
